# Variables de entorno de Rinde. Copiá este archivo como .env.local (desarrollo) y cargá los valores en
# Vercel → Settings → Environment Variables (producción). Nunca subas .env.local al repositorio.

# URL pública del sitio (para imágenes OG, sitemap y links absolutos). En Vercel: https://tu-dominio.com.ar
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Hoy ninguna fuente de datos pide API key: DolarAPI, ArgentinaDatos, data912, CriptoYa, BCRA v4 y Binance
# son públicas. Cuando sumemos fuentes con clave (mercados globales, fase 3) o cuentas (Supabase, fase 2),
# van acá:
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# TWELVE_DATA_API_KEY=
