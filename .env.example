# Variables de entorno de Rinde. Copiá este archivo como .env.local (desarrollo) y cargá los valores en
# Vercel → Settings → Environment Variables (producción). Nunca subas .env.local al repositorio.

# URL pública del sitio (para imágenes OG, sitemap y links absolutos). En Vercel: https://tu-dominio.com.ar
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cuentas de usuario (Supabase). Las carga sola la integración de Supabase en Vercel; para tenerlas en la compu:
# `vercel link` y `vercel env pull .env.local`. Sin ellas, las cuentas se apagan y la cartera sigue en el navegador.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Solo para `pnpm db:migrar` (crea las tablas) y pruebas: nunca en el navegador.
POSTGRES_URL_NON_POOLING=
SUPABASE_SECRET_KEY=

# Hoy ninguna fuente de datos pide API key: DolarAPI, ArgentinaDatos, data912, CriptoYa, BCRA v4 y Binance
# son públicas. Cuando sumemos fuentes con clave (mercados globales, fase 3), van acá:
# TWELVE_DATA_API_KEY=
